{
  "algorithm": "RandomForestClassifier",
  "n_estimators": 300,
  "max_depth": 10,
  "min_samples_leaf": 2,
  "class_weight": "balanced",
  "random_seed": 210821,
  "split": "70/30 stratified",
  "target": "event_label != NORMAL",
  "leakage_controls": [
    "event_label",
    "incident_id",
    "event_id",
    "timestamp excluded as raw field"
  ],
  "threshold": 0.5,
  "source_dataset": "t21_vendor_vpn_iam.csv"
}